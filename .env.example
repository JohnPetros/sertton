# Server-side variables for Expo Router API Routes only.
# Never prefix Yampi values with EXPO_PUBLIC_ and never import them from client code.
# Set real values only in the approved local secret store and EAS environment.
YAMPI_API_URL=
YAMPI_PURCHASE_URL=
YAMPI_USER_TOKEN=
YAMPI_SECRET_KEY=

# Public HTTPS origin of the deployed Expo API Routes, used only by native clients.
EXPO_PUBLIC_BFF_URL=
